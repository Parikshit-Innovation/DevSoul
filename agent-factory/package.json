{
  "name": "@devosoul/agent-factory",
  "version": "0.1.0",
  "description": "DevSoul Agent Factory — plans, validates, and configures AI agents for a given task.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --noEmit false",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
