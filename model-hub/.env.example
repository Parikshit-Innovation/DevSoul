# ─── Model Hub & Router Configuration ───────────────────────────
# OpenRouter Cloud Provider
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Ollama Local Provider
OLLAMA_BASE_URL=http://localhost:11434

# Model Hub Server Port
MODEL_HUB_PORT=3000

# Global Project-Level Privacy (forces all tasks to local models unless overridden with confirmation)
PRIVATE_PROJECT=false

# Optional Aegis Integration (enables forwarding audit logs to Aegis control plane)
AEGIS_AUDIT_INTEGRATION=false
