# Set to true to use the offline mock LLM (no API key needed)
RI_MOCK=false

# ── Server ────────────────────────────────────────────────────────
RI_PORT=8001
# Where output YAML is written (relative to requirement-intelligence/)
RI_OUTPUT_DIR=output
