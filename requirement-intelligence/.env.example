# ── Gemini ────────────────────────────────────────────────────────
GEMINI_API_KEY=AQ.Ab8RN6JgYUKiA8DAK0IvR3iAFSKGuBJ3gKFlpF8LGbvV2xS9sg
GEMINI_MODEL=gemini-2.5-flash

# ── Interview tuning ──────────────────────────────────────────────
