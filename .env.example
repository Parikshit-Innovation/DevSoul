# ─── Copy this file to .env and fill in your values ──────────
# DO NOT commit your .env file.

# ── Gateway ───────────────────────────────────────────────────
GATEWAY_PORT=8080
GATEWAY_SECRET=changeme

# ── Agent Factory ─────────────────────────────────────────────
AGENT_FACTORY_URL=http://localhost:8081
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=...
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-1.5-flash

# ── Aegis (Security) ──────────────────────────────────────────
AEGIS_PORT=8082
AEGIS_POLICY_DIR=./shared/schemas/policy.schema.yaml

# ── Requirement Intelligence ──────────────────────────────────
RI_PORT=8083
# Also needs: GEMINI_API_KEY (shared above), GEMINI_MODEL

# ── Architecture Intelligence ─────────────────────────────────
LLM_PROVIDER=gemini
# Also needs: GEMINI_API_KEY (shared above)

# ── Project Brain ─────────────────────────────────────────────
PB_PORT=8084
PB_VECTOR_DB_URL=http://localhost:6333

# ── Extension ─────────────────────────────────────────────────
VSCODE_EXT_ENV=development

# ── Full Intelligence Pipeline ────────────────────────────────
# Shared artifact directory (RI, AI, and Factory all write here)
DEVOS_DIR=.devos
